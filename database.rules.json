{
  "rules": {
    ".read": false,
    ".write": false,
    ".validate": false,

    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": false,
        "connections": {
          "$connectionId": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['connectedAt']) && newData.child('connectedAt').isNumber()"
          }
        },
        "status": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['state','updatedAt']) && (newData.child('state').val() === 'online' || newData.child('state').val() === 'offline') && newData.child('updatedAt').isNumber()"
        },
        "lastOnline": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber()"
        }
      }
    },

    "chatMembers": {
      "$chatId": {
        ".read": "auth != null && root.child('chatMembers').child($chatId).child(auth.uid).val() === true",
        ".write": false,
        "$uid": {
          ".read": "auth != null && root.child('chatMembers').child($chatId).child(auth.uid).val() === true"
        }
      }
    },

    "messages": {
      "$chatId": {
        ".read": "auth != null && root.child('chatMembers').child($chatId).child(auth.uid).val() === true",
        "$messageId": {
          ".write": "auth != null && root.child('chatMembers').child($chatId).child(auth.uid).val() === true && !data.exists() && newData.child('uid').val() === auth.uid",
          ".validate": "newData.hasChildren(['uid','createdAt','type']) && newData.child('uid').isString() && newData.child('createdAt').isNumber() && newData.child('type').isString() && (!newData.hasChild('text') || (newData.child('text').isString() && newData.child('text').val().length <= 20000)) && (!newData.hasChild('fileName') || newData.child('fileName').isString()) && (!newData.hasChild('fileUrl') || newData.child('fileUrl').isString())"
        }
      }
    },

    "typing": {
      "$chatId": {
        "$uid": {
          ".read": "auth != null && root.child('chatMembers').child($chatId).child(auth.uid).val() === true",
          ".write": "auth != null && auth.uid === $uid && root.child('chatMembers').child($chatId).child(auth.uid).val() === true",
          ".validate": "newData.isBoolean()"
        }
      }
    },

    "events": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$eventId": {
          ".write": "auth != null && auth.uid === $uid && !data.exists()",
          ".validate": "newData.hasChildren(['type','chatId','messageId','createdAt']) && newData.child('type').isString() && newData.child('chatId').isString() && newData.child('messageId').isString() && newData.child('createdAt').isNumber()"
        }
      }
    }
  }
}

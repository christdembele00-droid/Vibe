rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    function validFile() {
      return request.resource != null
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType != null;
    }

    match /profilePhotos/{uid}/{fileName} {
      allow read: if signedIn();
      allow create, update: if own(uid) && validFile() && request.resource.contentType.matches('image/.*') && request.resource.size <= 8 * 1024 * 1024;
      allow delete: if own(uid);
    }

    match /users/{uid}/uploads/{fileName} {
      allow read: if own(uid);
      allow create, update: if own(uid) && validFile();
      allow delete: if own(uid);
    }

    match /messages/{uid}/{fileName} {
      allow read: if signedIn();
      allow create, update: if own(uid) && validFile();
      allow delete: if own(uid);
    }

    // Chat-scoped media path used by the redesigned messenger.
    match /messages/{chatId}/{uid}/{fileName} {
      allow read: if signedIn();
      allow create, update: if own(uid) && validFile();
      allow delete: if own(uid);
    }

    match /voice/{uid}/{fileName} {
      allow read: if signedIn();
      allow create, update: if own(uid) && validFile();
      allow delete: if own(uid);
    }

    // Chat-scoped voice path used by the redesigned messenger.
    match /voice/{chatId}/{uid}/{fileName} {
      allow read: if signedIn();
      allow create, update: if own(uid) && validFile();
      allow delete: if own(uid);
    }

    match /statuses/{uid}/{fileName} {
      allow read: if signedIn();
      allow create, update: if own(uid) && validFile();
      allow delete: if own(uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

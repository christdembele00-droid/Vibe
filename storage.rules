rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    function validFile() {
      return request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType != null;
    }

    match /users/{uid}/uploads/{fileName} {
      allow read, write: if own(uid) && validFile();
    }

    match /messages/{uid}/{fileName} {
      allow read, write: if own(uid) && validFile();
    }

    match /voice/{uid}/{fileName} {
      allow read, write: if own(uid) && validFile();
    }

    match /statuses/{uid}/{fileName} {
      allow read: if signedIn();
      allow write: if own(uid) && validFile();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    function isMember(roomId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.participants;
    }

    function callParty(callId) {
      return get(/databases/$(database)/documents/calls/$(callId));
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /rooms/{roomId} {
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() >= 2
        && request.auth.uid in request.resource.data.participants;

      allow read: if isMember(roomId);

      allow update: if isMember(roomId)
        && request.resource.data.participants == resource.data.participants;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isMember(roomId);

        allow create: if isMember(roomId)
          && request.resource.data.sender == request.auth.uid
          && request.resource.data.readBy is list
          && request.resource.data.readBy.hasOnly([request.auth.uid]);

        allow update: if isMember(roomId) && (
          resource.data.sender == request.auth.uid
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
        );

        allow delete: if isMember(roomId) && resource.data.sender == request.auth.uid;
      }

      match /typing/{userId} {
        allow read: if isMember(roomId);
        allow create, update, delete: if isMember(roomId) && request.auth.uid == userId;
      }
    }

    match /groups/{groupId} {
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.participants is list
        && request.resource.data.participants.size() >= 2
        && request.auth.uid in request.resource.data.participants;

      allow read: if signedIn() && request.auth.uid in resource.data.participants;

      allow update: if signedIn()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants is list
        && request.resource.data.participants.size() >= 2;

      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /calls/{callId} {
      allow create: if signedIn()
        && request.resource.data.caller == request.auth.uid
        && request.resource.data.callee is string
        && request.resource.data.callee != request.auth.uid
        && request.resource.data.type in ['audio', 'video']
        && request.resource.data.status == 'ringing';

      allow read: if signedIn() && (
        resource.data.caller == request.auth.uid || resource.data.callee == request.auth.uid
      );

      allow update: if signedIn()
        && (resource.data.caller == request.auth.uid || resource.data.callee == request.auth.uid)
        && request.resource.data.caller == resource.data.caller
        && request.resource.data.callee == resource.data.callee
        && request.resource.data.type == resource.data.type
        && request.resource.data.status in ['ringing', 'accepted', 'rejected', 'ended'];

      allow delete: if signedIn() && (
        resource.data.caller == request.auth.uid || resource.data.callee == request.auth.uid
      );

      match /candidates-caller/{candidateId} {
        allow create: if signedIn() && callParty(callId).data.caller == request.auth.uid;
        allow read: if signedIn() && (
          callParty(callId).data.caller == request.auth.uid
          || callParty(callId).data.callee == request.auth.uid
        );
      }

      match /candidates-callee/{candidateId} {
        allow create: if signedIn() && callParty(callId).data.callee == request.auth.uid;
        allow read: if signedIn() && (
          callParty(callId).data.caller == request.auth.uid
          || callParty(callId).data.callee == request.auth.uid
        );
      }
    }
  }
}
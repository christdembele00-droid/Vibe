rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Fonction utilitaire pour vérifier si l'utilisateur est connecté
    function isAuthenticated() {
      return request.auth != null;
    }

    // Règles pour les canaux de discussion
    match /channels/{channelId} {
      // Tout utilisateur connecté peut lire la liste des canaux
      allow read: if isAuthenticated();

      // Autoriser l'écriture sur les canaux (ou restreindre aux admins si besoin)
      allow write: if isAuthenticated();

      // 1. Sous-collection : LES MESSAGES
      match /messages/{messageId} {
        // Lecture : accessible à tous les utilisateurs connectés
        allow read: if isAuthenticated();

        // Création : l'utilisateur doit être connecté et l'ID de l'expéditeur doit correspondre à son UID Firebase Auth
        allow create: if isAuthenticated()
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0;

        // Modification ou Suppression : uniquement par l'auteur original du message
        allow update, delete: if isAuthenticated()
                              && resource.data.senderId == request.auth.uid;
      }

      // 2. Sous-collection : INDICATEUR DE FRAPPE ("En train d'écrire...")
      match /typing/{userId} {
        // Tout le monde peut lire qui est en train d'écrire
        allow read: if isAuthenticated();

        // Un utilisateur ne peut modifier / créer que son propre document de statut de frappe
        allow write: if isAuthenticated() && userId == request.auth.uid;
      }
    }
  }
}
